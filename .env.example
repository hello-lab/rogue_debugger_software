# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Sheets Configuration
# Service account credentials for Google Sheets API
GOOGLE_CLIENT_EMAIL=your_google_service_account_email_here
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with actual credentials
# 3. Keep the quotes around GOOGLE_PRIVATE_KEY
# 4. Don't commit .env to Git (it's already in .gitignore)
